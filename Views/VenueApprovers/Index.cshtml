@model IEnumerable<FINALS.Models.VenueApprover>

@{
    ViewData["Title"] = "Approving Offices";
}

<h1 class="mb-3">Approving Offices</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">Create New</a>
</p>

@foreach (var group in Model.GroupBy(a => a.Venue.Name).OrderBy(g => g.Key))
{
    <h4 class="mt-4 mb-3">@group.Key</h4>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var item in group.OrderBy(a => a.StepOrder))
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <span class="badge bg-secondary mb-2">Step @item.StepOrder</span>
                        <h5 class="card-title">@item.Office</h5>
                        <p class="card-text text-muted">@item.Email</p>
                    </div>
                    <div class="card-footer bg-white">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id">Details</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </div>
                </div>
            </div>
        }
    </div>
}