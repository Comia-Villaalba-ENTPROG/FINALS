@model FINALS.Models.Reservation

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Reservation</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="OrganizationId" class="control-label"></label>
                <select asp-for="OrganizationId" class ="form-control" asp-items="ViewBag.OrganizationId"></select>
            </div>
            <div class="form-group">
    <label asp-for="VenueId" class="control-label"></label>
    <select asp-for="VenueId" class="form-control" asp-items="ViewBag.VenueId"></select>
    <span asp-validation-for="VenueId" class="text-danger"></span>
</div>
            <div class="form-group">
                <label asp-for="ActivityName" class="control-label"></label>
                <input asp-for="ActivityName" class="form-control" />
                <span asp-validation-for="ActivityName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ReservationDate" class="control-label"></label>
                <input asp-for="ReservationDate" class="form-control" />
                <span asp-validation-for="ReservationDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="StartTime" class="control-label"></label>
                <input asp-for="StartTime" class="form-control" />
                <span asp-validation-for="StartTime" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EndTime" class="control-label"></label>
                <input asp-for="EndTime" class="form-control" />
                <span asp-validation-for="EndTime" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ExpectedAttendees" class="control-label"></label>
                <input asp-for="ExpectedAttendees" class="form-control" />
                <span asp-validation-for="ExpectedAttendees" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="RequesterName" class="control-label"></label>
                <input asp-for="RequesterName" class="form-control" />
                <span asp-validation-for="RequesterName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="RequesterEmail" class="control-label"></label>
                <input asp-for="RequesterEmail" class="form-control" />
                <span asp-validation-for="RequesterEmail" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="RequesterContact" class="control-label"></label>
                <input asp-for="RequesterContact" class="form-control" />
                <span asp-validation-for="RequesterContact" class="text-danger"></span>
            </div>
            <hr />
<h4>Equipment Requested</h4>
<p class="text-muted">Leave the quantity at 0 for items you do not need.</p>

<table class="table table-sm table-bordered">
    <thead>
        <tr>
            <th>Item</th>
            <th>Available</th>
            <th style="width:120px">Quantity</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var e in (List<FINALS.Models.Equipment>)ViewBag.EquipmentList)
        {
            <tr>
                <td>@e.Name</td>
                <td>@e.Quantity</td>
                <td>
                    <input type="hidden" name="equipmentIds" value="@e.Id" />
                    <input type="number" name="quantities" value="0" min="0" class="form-control form-control-sm" />
                </td>
            </tr>
        }
    </tbody>
</table>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
