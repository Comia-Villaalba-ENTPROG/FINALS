@model FINALS.Models.Reservation

@{
    ViewData["Title"] = "Details";
}

<h1>Reservation Details</h1>

<table class="table table-bordered">
    <tr>
        <th style="width: 30%">Tracking Number</th>
        <td>@Model.TrackingNumber</td>
    </tr>
    <tr>
        <th>Organization</th>
        <td>@Model.Organization?.Name</td>
    </tr>
    <tr>
        <th>Venue</th>
        <td>@Model.Venue?.Name</td>
    </tr>
    <tr>
        <th>Activity</th>
        <td>@Model.ActivityName</td>
    </tr>
    <tr>
        <th>Date</th>
        <td>@Model.ReservationDate.ToString("MMMM d, yyyy")</td>
    </tr>
    <tr>
        <th>Time</th>
        <td>@Model.StartTime.ToString("h:mm tt") to @Model.EndTime.ToString("h:mm tt")</td>
    </tr>
    <tr>
        <th>Expected Attendees</th>
        <td>@Model.ExpectedAttendees</td>
    </tr>
    <tr>
        <th>Requested By</th>
        <td>@Model.RequesterName</td>
    </tr>
    <tr>
        <th>Email</th>
        <td>@Model.RequesterEmail</td>
    </tr>
    <tr>
        <th>Contact Number</th>
        <td>@Model.RequesterContact</td>
    </tr>
    <tr>
        <th>Status</th>
        <td>
            @if (Model.Status == "Approved")
            {
                <span class="badge bg-success">Approved</span>
            }
            else if (Model.Status == "Rejected")
            {
                <span class="badge bg-danger">Rejected</span>
            }
            else
            {
                <span class="badge bg-warning text-dark">Pending</span>
            }
        </td>
    </tr>
    <tr>
        <th>Current Approval Step</th>
        <td>@Model.CurrentStep</td>
    </tr>
    <tr>
        <th>Date Submitted</th>
        <td>@Model.DateSubmitted.ToString("MMMM d, yyyy h:mm tt")</td>
    </tr>
</table>

@{
    var equipment = ViewBag.Equipment as List<FINALS.Models.ReservationEquipment>;
}

@if (equipment != null && equipment.Any())
{
    <h4>Equipment Requested</h4>
    <table class="table table-sm table-bordered">
        <thead>
            <tr>
                <th style="width:30%">Item</th>
                <th>Quantity</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in equipment)
            {
                <tr>
                    <td>@line.Equipment?.Name</td>
                    <td>@line.Quantity</td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary">Edit</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>