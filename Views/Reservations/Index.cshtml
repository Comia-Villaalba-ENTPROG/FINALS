@model IEnumerable<FINALS.Models.Reservation>

@{
    ViewData["Title"] = "Reservations";
}

<h1 class="mb-3">Reservations</h1>

<div class="row g-2 mb-4">
    <div class="col-md-5">
        <input type="text" id="searchBox" class="form-control"
               placeholder="Search tracking number, organization or venue"
               oninput="filterCards()" />
    </div>
    <div class="col-md-2">
        <select id="statusFilter" class="form-select" onchange="filterCards()">
            <option value="">All statuses</option>
            <option value="Pending">Pending</option>
            <option value="Approved">Approved</option>
            <option value="Rejected">Rejected</option>
        </select>
    </div>
    <div class="col-md-3">
        <select id="dateFilter" class="form-select" onchange="filterCards()">
            <option value="">All dates</option>
            <option value="today">Today</option>
            <option value="week">This week</option>
            <option value="month">This month</option>
            <option value="upcoming">Upcoming</option>
            <option value="past">Past</option>
        </select>
    </div>
    <div class="col-md-2 d-flex align-items-center">
        <span id="rowCount" class="text-muted small"></span>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4" id="reservationCards">
    @foreach (var item in Model)
    {
        <div class="col reservation-card"
             data-status="@item.Status"
             data-date="@item.ReservationDate.ToString("yyyy-MM-dd")"
             data-search="@((item.TrackingNumber + " " + item.Organization?.Name + " " + item.Venue?.Name).ToLower())">
            <div class="card h-100 shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <strong>@item.TrackingNumber</strong>
                    @if (item.Status == "Approved")
                    {
                        <span class="badge bg-success">Approved</span>
                    }
                    else if (item.Status == "Rejected")
                    {
                        <span class="badge bg-danger">Rejected</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">Pending</span>
                    }
                </div>
                <div class="card-body">
                    <h5 class="card-title">@item.ActivityName</h5>
                    <p class="card-text mb-1"><strong>Organization:</strong> @item.Organization?.Name</p>
                    <p class="card-text mb-1"><strong>Venue:</strong> @item.Venue?.Name</p>
                    <p class="card-text mb-1"><strong>Date:</strong> @item.ReservationDate.ToString("MMM d, yyyy")</p>
                    <p class="card-text mb-1"><strong>Time:</strong> @item.StartTime.ToString("h:mm tt") to @item.EndTime.ToString("h:mm tt")</p>
                    <p class="card-text text-muted mb-0">Step @item.CurrentStep</p>
                </div>
                <div class="card-footer bg-white">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id">Details</a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function pad(n) { return n < 10 ? "0" + n : "" + n; }

        function toStr(d) {
            return d.getFullYear() + "-" + pad(d.getMonth() + 1) + "-" + pad(d.getDate());
        }

        function matchesDate(filter, dateStr) {
            if (filter === "") { return true; }

            var now = new Date();
            var today = toStr(now);

            if (filter === "today") { return dateStr === today; }
            if (filter === "upcoming") { return dateStr >= today; }
            if (filter === "past") { return dateStr < today; }

            if (filter === "week") {
                var start = new Date(now);
                start.setDate(now.getDate() - now.getDay());
                var end = new Date(start);
                end.setDate(start.getDate() + 6);
                return dateStr >= toStr(start) && dateStr <= toStr(end);
            }

            if (filter === "month") {
                return dateStr.substring(0, 7) === today.substring(0, 7);
            }

            return true;
        }

        function filterCards() {
            var search = document.getElementById("searchBox").value.toLowerCase();
            var status = document.getElementById("statusFilter").value;
            var dateFilter = document.getElementById("dateFilter").value;
            var cards = document.querySelectorAll("#reservationCards .reservation-card");
            var shown = 0;

            for (var i = 0; i < cards.length; i++) {
                var card = cards[i];

                var okSearch = card.getAttribute("data-search").indexOf(search) !== -1;
                var okStatus = (status === "" || status === card.getAttribute("data-status"));
                var okDate = matchesDate(dateFilter, card.getAttribute("data-date"));

                if (okSearch && okStatus && okDate) {
                    card.style.display = "";
                    shown++;
                } else {
                    card.style.display = "none";
                }
            }

            document.getElementById("rowCount").textContent =
                shown + " of " + cards.length + " reservations";
        }

        filterCards();
    </script>
}